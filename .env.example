# Copy this file to .env and fill in your own keys. Never commit .env.

# Which provider is tried first: groq or gemini (the other one is the fallback)
PRIMARY_LLM_PROVIDER=groq

GROQ_API_KEY=
GOOGLE_API_KEY=            # GEMINI_API_KEY is also accepted

# Model names (check yours with test_models/groq_models.py and gemini_models.py)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash

# Retrieval: chunks below this cosine similarity are ignored (0-1)
RELEVANCE_THRESHOLD=0.30

# Frontend: leave empty to run everything inside Streamlit,
# or point to the FastAPI server, e.g. http://localhost:8000
API_URL=
# Backend only: browser origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:8501
MAX_UPLOAD_MB=20
